<?xml version="1.0" encoding="UTF-8"?>
<!--
  Exit Ready Scorecard prototype: keep this folder out of search results.
  Windows / IIS hosting only. On Apache use .htaccess instead.
-->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="X-Robots-Tag" value="noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Cache-Control" value="private, no-store, max-age=0" />
      </customHeaders>
    </httpProtocol>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
